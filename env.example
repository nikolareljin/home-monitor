# Django configuration
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=UTC
RECOMMENDATION_WINDOW_HOURS=6

# Database (PostgreSQL)
POSTGRES_DB=home_monitor
POSTGRES_USER=home_monitor
POSTGRES_PASSWORD=super-secret-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Allthings Wave integration
ALLTHINGS_WAVE_BASE_URL=https://api.allthings.io
ALLTHINGS_WAVE_API_KEY=

# Weather provider (OpenWeatherMap by default)
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=

# Ollama: the machine's own, on the host (there is no Ollama container here).
# The address the backend container uses for it:
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# The model is the one ai-models.env names. Set it here only to try another one on this machine.
# OLLAMA_MODEL=
# A missing model is offered for download on a terminal; 1 pulls without asking, 0 never.
# OLLAMA_PULL_MISSING=ask

# Home Assistant integration
HOME_ASSISTANT_BASE_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=

# Future sensor integrations
GOVEE_API_KEY=
ECOQUBE_API_TOKEN=

# Frontend defaults
VITE_API_BASE_URL=http://localhost:8000/api
